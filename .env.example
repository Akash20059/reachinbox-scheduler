# Server & App Config
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# Database (PostgreSQL with Prisma)
DATABASE_URL=postgresql://reachinbox:reachinbox123@localhost:5432/reachinbox_scheduler?schema=public

# Redis (BullMQ, Idempotency & Atomic Lua Rate Limiting)
REDIS_URL=redis://localhost:6379

# Elasticsearch (Full-Text Search Engine)
ELASTICSEARCH_URL=http://localhost:9200

# Bull-Board Monitoring Dashboard Basic Auth
BULL_BOARD_USER=admin
BULL_BOARD_PASS=admin123

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Slack OAuth 2.0 & Incoming Webhook Alerts
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:4000/slack/callback
SLACK_SIGNING_SECRET=your_slack_signing_secret

