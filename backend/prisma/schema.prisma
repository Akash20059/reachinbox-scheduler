datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum JobStatus {
  scheduled
  processing
  sent
  failed
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  name            String?
  avatar          String?
  googleId        String?          @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  jobs            EmailJob[]
  batches         Batch[]
  slackConnection SlackConnection?
}

model Sender {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  host      String     @default("smtp.ethereal.email")
  port      Int        @default(587)
  user      String
  pass      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  jobs      EmailJob[]
}

model Batch {
  id             String     @id @default(uuid())
  userId         String?
  subject        String
  body           String
  delayBetweenMs Int?
  hourlyLimit    Int?
  totalCount     Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  jobs           EmailJob[]

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model EmailJob {
  id             String    @id @default(uuid())
  userId         String?
  senderId       String
  toEmail        String
  subject        String
  body           String
  delayBetweenMs Int?
  hourlyLimit    Int?
  scheduledAt    DateTime
  sentAt         DateTime?
  status         JobStatus @default(scheduled)
  attempts       Int       @default(0)
  error          String?
  batchId        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  sender Sender  @relation(fields: [senderId], references: [id], onDelete: Cascade)
  batch  Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([scheduledAt])
  @@index([senderId])
  @@index([userId])
  @@index([batchId])
}

model SlackConnection {
  id          String   @id @default(uuid())
  userId      String   @unique
  webhookUrl  String?
  channel     String?
  teamName    String?
  accessToken String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
